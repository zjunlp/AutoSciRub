{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zjunlp/AutoSciRub/blob/main/config/sources.schema.json",
  "title": "AutoSciRub retrieval configuration",
  "type": "object",
  "properties": {
    "state_dir": {
      "type": "string",
      "minLength": 1
    },
    "retrieval": {
      "type": "object",
      "properties": {
        "enabled_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "providers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "api_key_env": {
                "type": "string"
              },
              "email_env": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_queries_per_goal": {
              "type": "integer",
              "minimum": 1
            },
            "max_core_sources": {
              "type": "integer",
              "minimum": 1
            },
            "max_supplemental_sources": {
              "type": "integer",
              "minimum": 1
            },
            "max_results_per_query": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "exclusions": {
          "type": "object",
          "properties": {
            "excluded_paths": {
              "$ref": "#/$defs/stringList"
            },
            "blocked_titles": {
              "$ref": "#/$defs/stringList"
            },
            "blocked_domains": {
              "$ref": "#/$defs/stringList"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "state_dir",
    "retrieval"
  ],
  "additionalProperties": false,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
