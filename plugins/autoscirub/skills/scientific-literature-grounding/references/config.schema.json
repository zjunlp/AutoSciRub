{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoSciRub project configuration (partial overrides allowed)",
  "type": "object",
  "properties": {
    "state_dir": {
      "type": "string",
      "pattern": "\\S"
    },
    "workflow": {
      "type": "object",
      "properties": {
        "max_revision_rounds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "retrieval": {
      "type": "object",
      "properties": {
        "enabled_sources": {
          "type": "array",
          "items": {
            "enum": [
              "local_literature",
              "arxiv",
              "openalex",
              "semantic_scholar",
              "tavily",
              "web"
            ]
          },
          "uniqueItems": true
        },
        "local_literature": {
          "type": "object",
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "providers": {
          "type": "object",
          "properties": {
            "arxiv": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "openalex": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "email_env": {
                  "type": "string",
                  "pattern": "\\S"
                },
                "api_key_env": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "additionalProperties": false
            },
            "semantic_scholar": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "api_key_env": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "additionalProperties": false
            },
            "tavily": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "api_key_env": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "additionalProperties": false
            },
            "mineru": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "api_key_env": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_queries_per_goal": {
              "type": "integer",
              "minimum": 1
            },
            "max_core_sources": {
              "type": "integer",
              "minimum": 0
            },
            "max_supplemental_sources": {
              "type": "integer",
              "minimum": 0
            },
            "max_results_per_query": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false
        },
        "exclusions": {
          "type": "object",
          "properties": {
            "excluded_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              },
              "uniqueItems": true
            },
            "blocked_titles": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              },
              "uniqueItems": true
            },
            "blocked_domains": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
