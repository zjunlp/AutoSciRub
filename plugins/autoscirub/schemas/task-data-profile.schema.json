  "title": "AutoSciRub Task Data Profile",
  "type": "object",
  "required": ["schema_version", "files", "datasets", "relationships", "constraints", "goal_support"],
  "properties": {
    "schema_version": { "type": "string" },
    "files": { "type": "array" },
    "datasets": { "type": "array" },
    "relationships": { "type": "array" },
    "constraints": { "type": "array" },
    "goal_support": { "type": "array" },
    "dependency_notes": { "type": "array" }
  },
  "additionalProperties": true
}
